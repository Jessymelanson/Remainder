<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        No permissions at all. Remainder does its arithmetic on this phone and
        keeps the numbers in its own private storage. There is nothing to send
        anywhere, so there is no internet permission to send it with.
    -->

    <!--
        allowBackup is off, and that is the setting that makes the sentence
        above true rather than aspirational.

        Left on, Android copies this app's private storage - which is the whole
        budget: take home pay, every bill, every savings balance - to the user's
        Google Drive, and restores it onto whatever device next signs in. The
        rules files were supposed to prevent that and did not: both excluded
        "frontwatch.xml", another app's preferences file, so the exclusion
        matched nothing and the default of backing everything up applied.

        Off is also what the rest of the app already assumes. Settings has Back
        up and Restore precisely because the data does not leave the phone on
        its own, and those write a file the person chooses, to a place they
        choose, when they decide to.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Remainder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Remainder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
