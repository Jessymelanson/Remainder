<?xml version="1.0" encoding="utf-8"?>
<!--
    Used only on Android 11 and below, and only if allowBackup is ever turned
    back on. The manifest sets it to false, for the reason written there.

    This file used to exclude "frontwatch.xml", which is a different app's
    preferences and has never existed here - so the rule matched nothing and
    remainder.xml, which is the entire budget, was covered by the default of
    backing everything up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="remainder.xml" />
</full-backup-content>
