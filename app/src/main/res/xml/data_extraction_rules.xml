<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. Same story as backup_rules.xml: the excluded path
    named another app's preferences file, so it excluded nothing.

    Device transfer is excluded as well as cloud backup. A phone-to-phone
    transfer does not go through anybody else's server, but it does copy the
    budget onto a device the person may be setting up for someone else, and
    Settings already has Back up and Restore for moving it deliberately.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="remainder.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remainder.xml" />
    </device-transfer>
</data-extraction-rules>
